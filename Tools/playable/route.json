{
  "schema": 1,
  "scene": "Assets/Game/01.Scene/Main.unity",
  "size": [
    1920,
    1080
  ],
  "sizes": [
    [
      1920,
      1080
    ],
    [
      2340,
      1080
    ],
    [
      2520,
      1080
    ],
    [
      2048,
      1536
    ]
  ],
  "time_scale": 1,
  "steps": [
    {
      "id": "G1",
      "name": "시작: 로비 화면, 캐릭터 카드 4장, 출발 버튼이 눌리는 상태",
      "wait": "PlayableProbe.Screen == \"Lobby\" && PlayableProbe.CardCount == 4 && PlayableProbe.CanDepart",
      "capture": "all"
    },
    {
      "id": "G2",
      "name": "출발 → 전투 화면, 웨이브 1, 생존 4명, 남은 시간이 줄어든다",
      "do": "PlayableProbe.UseRunSettings(1, 1f); PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 1 && PlayableProbe.AliveCount == 4 && PlayableProbe.RemainingSeconds < PlayableProbe.WaveSeconds - 1",
      "capture": "all"
    },
    {
      "id": "G3",
      "name": "자동 이동 봇으로 웨이브 1을 끝까지 → 정비 화면, 웨이브 1 완료, 보관함 새 아이템 3~5개(M4: 잃는 동료 0)",
      "do": "UnityEngine.Time.timeScale = 20f; PlayableProbe.StartBot(PlayableProbe.BotMode.Move);",
      "wait": "PlayableProbe.Screen == \"Prep\" && PlayableProbe.CompletedWave == 1",
      "timeout": 30,
      "expect": "PlayableProbe.StashCount >= 3 && PlayableProbe.StashCount <= 5 && PlayableProbe.AliveCount == 4",
      "capture": "all"
    },
    {
      "id": "G4",
      "name": "보관함 아이템 1개를 가방에 넣고 다음 웨이브 → 웨이브 2, 넣은 아이템이 발동 목록에 있다",
      "do": "PlayableProbe.PlaceFirstStashItem(); PlayableProbe.PressNextWave();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 2",
      "expect": "PlayableProbe.IsPlacedItemActive"
    },
    {
      "id": "G5",
      "name": "봇 이동을 멈추고 가만히 버팀 → 결과 패배, 버틴 웨이브 10 미만, 생존 0",
      "do": "PlayableProbe.StartWaveMetrics(\"Logs/playable/latest/wave-metrics.json\", false); PlayableProbe.StartBot(PlayableProbe.BotMode.AutoNext);",
      "wait": "PlayableProbe.Screen == \"Result\"",
      "timeout": 60,
      "expect": "PlayableProbe.Outcome == \"Lose\" && PlayableProbe.WavesSurvived < 10 && PlayableProbe.AliveCount == 0 && PlayableProbe.WavesSurvived >= 1 && PlayableProbe.WavesSurvived <= 4",
      "capture": "all"
    },
    {
      "id": "G6",
      "name": "로비로 → 출발 → 웨이브 1, 처치 0, 생존 4명, 시작 아이템만 장착",
      "do": "PlayableProbe.StopBot(); PlayableProbe.UseRunSettings(7, 1f); PlayableProbe.PressToLobby(); PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 1 && PlayableProbe.Kills == 0 && PlayableProbe.AliveCount == 4 && PlayableProbe.HasOnlyStartItems"
    },
    {
      "id": "G7",
      "name": "고정 시드, 자동 이동 + 전리품 자동 장착 봇으로 10웨이브 → 결과 승리, 버틴 웨이브 10, 생존 1명 이상(M1 435±2초) — M7 성능은 사용자 지시로 7단계까지 미판정(표본 수집 끔)",
      "do": "UnityEngine.Time.timeScale = 20f; PlayableProbe.StartBot(PlayableProbe.BotMode.Move | PlayableProbe.BotMode.Equip | PlayableProbe.BotMode.AutoNext); PlayableProbe.UseRealTimeAtWave(10);",
      "wait": "PlayableProbe.Screen == \"Result\"",
      "timeout": 185,
      "expect": "PlayableProbe.Outcome == \"Win\" && PlayableProbe.WavesSurvived == 10 && PlayableProbe.AliveCount >= 1 && Math.Abs(PlayableProbe.TotalBattleSeconds - 435) <= 2 && PlayableProbe.IsSpawnCountNear(98, 407, 0.05f) && PlayableProbe.FirstWaveOf(\"projectile\") == 3 && PlayableProbe.FirstWaveOf(\"charge\") == 4 && PlayableProbe.FirstWaveOf(\"armored\") == 5 && PlayableProbe.FirstWaveOf(\"bomb\") == 6"
    },
    {
      "id": "G8",
      "name": "로비로 → 출발 → 세 번째 판이 웨이브 1, 처치 0으로 시작",
      "do": "PlayableProbe.StopBot(); PlayableProbe.UseRunSettings(8, 1f); PlayableProbe.PressToLobby(); PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 1 && PlayableProbe.Kills == 0 && PlayableProbe.RunCount == 3"
    }
  ]
}
