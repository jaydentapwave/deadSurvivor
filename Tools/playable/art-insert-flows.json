      "do": "PlayableProbe.ArmEffectCapture(\"lightning\", \".director/evidence/20261117-insert-fx/1/1/effect-states\");",
      "wait": "PlayableProbe.IsEffectCaptureReady",
      "timeout": 45,
      "expect": "PlayableProbe.EffectVisibleCount(\"lightning\") > 0 && PlayableProbe.EffectShownCount(\"lightning\") > 0",
