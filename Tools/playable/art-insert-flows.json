    {
      "id": "FXHIT2",
      "name": "피격 별 연속 표본: 0.05초 진행 뒤 같은 화면의 남은 별",
      "do": "PlayableProbe.ArmEffectCapture(\"hit_star\", \".director/evidence/20261117-insert-fx/1/1/effect-states\");",
