      "do": "PlayableProbe.ArmEffectCapture(\"crossbow_bolt\", \".director/evidence/20261117-insert-fx/1/1/effect-states\");",
      "wait": "PlayableProbe.IsEffectCaptureReady",
      "timeout": 45,
