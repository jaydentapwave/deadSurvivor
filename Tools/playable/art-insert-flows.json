      "do": "PlayableProbe.ArmEffectCapture(\"arrow\", \".director/evidence/20261117-insert-fx/1/1/effect-states\");",
      "wait": "PlayableProbe.IsEffectCaptureReady",
      "timeout": 45,
      "expect": "PlayableProbe.EffectVisibleCount(\"arrow\") > 0 && PlayableProbe.EffectShownCount(\"arrow\") > 0",
