{
  "schema": 1,
  "scene": "Assets/Game/01.Scene/Main.unity",
  "size": [
    1920,
    1080
  ],
  "sizes": [
    [
      1920,
      1080
    ],
    [
      2340,
      1080
    ],
    [
      2520,
      1080
    ],
    [
      2048,
      1536
    ]
  ],
  "time_scale": 1,
  "steps": [
    {
      "id": "L1",
      "name": "로비 도착",
      "wait": "PlayableProbe.Screen == \"Lobby\" && PlayableProbe.CanDepart"
    },
    {
      "id": "B1",
      "name": "적 수 배율 0으로 출발 → 전투 웨이브 1",
      "do": "PlayableProbe.UseRunSettings(1, 0f); PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 1 && PlayableProbe.AliveCount == 4"
    },
    {
      "id": "P1",
      "name": "웨이브 시간(30초, 1배속)이 끝나면 정비 화면, 웨이브 1 완료",
      "wait": "PlayableProbe.Screen == \"Prep\" && PlayableProbe.CompletedWave == 1",
      "timeout": 45,
      "capture": "all"
    },
    {
      "id": "B2",
      "name": "다음 웨이브 → 웨이브 2가 생존 4명으로 시작",
      "do": "PlayableProbe.PressNextWave();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 2 && PlayableProbe.AliveCount == 4"
    },
    {
      "id": "WIN",
      "name": "10웨이브 끝까지 → 결과 승리, 버틴 웨이브 10, 전투 시간 435±2초(M1)",
      "do": "UnityEngine.Time.timeScale = 20f; PlayableProbe.StartBot(PlayableProbe.BotMode.AutoNext);",
      "wait": "PlayableProbe.Screen == \"Result\"",
      "timeout": 120,
      "expect": "PlayableProbe.Outcome == \"Win\" && PlayableProbe.WavesSurvived == 10 && PlayableProbe.AliveCount == 4 && Math.Abs(PlayableProbe.TotalBattleSeconds - 435) <= 2",
      "capture": "all"
    },
    {
      "id": "LOSE",
      "name": "적 수 배율을 올린 판을 가만히 두면 전멸 → 결과 패배(봇은 정비만 넘김)",
      "do": "PlayableProbe.UseRunSettings(2, 4f); PlayableProbe.PressToLobby(); PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Result\"",
      "timeout": 120,
      "expect": "PlayableProbe.Outcome == \"Lose\" && PlayableProbe.AliveCount == 0 && PlayableProbe.WavesSurvived < 10"
    },
    {
      "id": "LOBBY2",
      "name": "로비로 → 로비",
      "do": "PlayableProbe.StopBot(); UnityEngine.Time.timeScale = 1f; PlayableProbe.PressToLobby();",
      "wait": "PlayableProbe.Screen == \"Lobby\" && PlayableProbe.CanDepart"
    },
    {
      "id": "RUN3",
      "name": "출발 → Play 뒤 세 번째 판이 웨이브 1, 처치 0, 생존 4명으로 시작",
      "do": "PlayableProbe.PressDepart();",
      "wait": "PlayableProbe.Screen == \"Battle\" && PlayableProbe.Wave == 1 && PlayableProbe.Kills == 0 && PlayableProbe.AliveCount == 4 && PlayableProbe.RunCount == 3"
    }
  ]
}
