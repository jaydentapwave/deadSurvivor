{
  "schema": 1,
  "scene": "Assets/Game/01.Scene/Main.unity",
  "size": [
    1920,
    1080
  ],
  "time_scale": 1,
  "steps": [
    {
      "id": "LOBBY",
      "name": "로비",
      "wait": "PlayableProbe.Screen == \"Lobby\""
    },
    {
      "id": "START",
      "name": "seed8 시작 같은 프레임",
      "do": "UnityEngine.Random.InitState(8); PlayableProbe.UseRunSettings(8,.05f); HD2DLightCapture.Arm(1,1); PlayableProbe.PressDepart();",
      "wait": "HD2DLightCapture.IsFrozen",
      "expect": "PlayableProbe.Wave == 1 && HD2DLightCapture.WaveFrame == 1",
      "capture": true
    },
    {
      "id": "BATTLE",
      "name": "웨이브6 60번째 프레임",
      "do": "HD2DLightCapture.Arm(6,60); PlayableProbe.StartBot(PlayableProbe.BotMode.AutoNext | PlayableProbe.BotMode.Equip); UnityEngine.Time.timeScale=10f;",
      "wait": "HD2DLightCapture.IsFrozen",
      "timeout": 240,
      "expect": "PlayableProbe.Wave == 6 && HD2DLightCapture.WaveFrame >= 60 && PlayableProbe.DamageNumberCount > 0 && PlayableProbe.MonsterHpBarCount > 0",
      "capture": true
    },
    {
      "id": "MOTION",
      "name": "시간 흐름 0.25초 간격8장",
      "do": "System.IO.Directory.CreateDirectory(\"output/hd2d-light/L5\"); System.IO.File.WriteAllText(\"output/hd2d-light/L5/states.csv\",\"sample,unityFrame,time,count,rate,limit,pose\\n\"); HD2DLightCapture.CaptureMotion(i=>{HD2DMainPlateCapture.CaptureStill(\"output/hd2d-light/L5/motion-\"+i+\".png\");var c=UnityEngine.Object.FindAnyObjectByType<GameSceneLifetimeScope>().Container;var a=(AmbientEffectsPresenter)c.Resolve(typeof(AmbientEffectsPresenter));System.IO.File.AppendAllText(\"output/hd2d-light/L5/states.csv\",i+\",\"+UnityEngine.Time.frameCount+\",\"+UnityEngine.Time.time+\",\"+a.DustCount+\",\"+a.DustRate+\",\"+a.DustLimit+\",\"+a.MotionFrame+\"\\n\");});",
      "wait": "HD2DLightCapture.IsMotionCaptured",
      "timeout": 30,
      "expect": "UnityEngine.Time.timeScale == 0f"
    }
  ]
}
