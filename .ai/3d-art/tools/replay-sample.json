{
 "schema": "3dkit-replay-cases/1",
 "note": "The kit's replay cases (tools/replay.py run): past defects of the art pipeline put into a sample project the runner builds. src names the problem-log entry (harness.problem_log of the project the kit was built in) or the rule each one came from. A project adds its own cases on its real data in harness.replay_cases.",
 "cases": [
  {"id": "J1", "src": "B9·B5", "fault": "큰 소품 프리팹이 높이 1로 눌림(목표 1.4)", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=well].prefab.height", "value": 1.0}], "code": "^well: .*prefab not normalised", "expect": "detected"},
  {"id": "J2", "src": "B20·B22", "fault": "주인공 발이 4.8cm 뜸", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=hero].prefab.feet", "value": 0.048}], "code": "^hero: .*prefab not normalised", "expect": "detected"},
  {"id": "J5", "src": "B27", "fault": "동작 수정 뒤 주인공 크기가 1.5% 줄어듦", "kind": "judge",
   "mutate": [{"file": "measured", "scale": "items[id=hero].prefab.height", "by": 0.985}], "code": "^hero: .*prefab not normalised", "expect": "detected"},
  {"id": "J6", "src": "T9", "fault": "소품 삼각형 초과", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=prop].prefab.tris", "value": 99999}], "code": "^prop: tris 99999 >", "expect": "detected"},
  {"id": "J7", "src": "B17", "fault": "재질 셰이더가 깨짐(분홍)", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=well].material.shader", "value": "Hidden/InternalErrorShader"}], "code": "^well: shader Hidden/InternalErrorShader", "expect": "detected"},
  {"id": "J8", "src": "W20", "fault": "텍스처가 사라짐", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=well].textures.albedo", "value": {"missing": true}}], "code": "^well: texture albedo", "expect": "detected"},
  {"id": "J9", "src": "B23", "fault": "에셋 폴더가 사라짐", "kind": "judge",
   "mutate": [{"file": "measured", "set": "items[id=well].folder_exists", "value": false}], "code": "^well: folder missing", "expect": "detected"},
  {"id": "J10", "src": "W2 계열", "fault": "장면이 쓰는 에셋이 trial로 돌아감", "kind": "judge",
   "mutate": [{"file": "catalog", "set": "assets[id=prop].status", "value": "trial"}], "code": "unregistered art Assets/Game/Art/Field/prop/", "expect": "detected"},
  {"id": "J11", "src": "삭제 작업", "fault": "장면이 쓰는 에셋을 카탈로그에서 지움", "kind": "judge",
   "mutate": [{"file": "catalog", "del": "assets[id=well]"}, {"file": "measured", "del": "items[id=well]"}], "code": "unregistered art Assets/Game/Art/Field/well/", "expect": "detected"},
  {"id": "J12", "src": "W2", "fault": "대체된 옛 버전까지 채택(pot + pot_r2)", "kind": "judge",
   "mutate": [{"file": "catalog", "set": "assets[id=pot].status", "value": "adopted"}], "code": "^SUPERSEDED_STILL_ADOPTED pot ", "expect": "detected"},
  {"id": "S1", "src": "B37", "fault": "게임 장면이 빌드 목록에 없음(검사가 빈 장면만 봄)", "kind": "judge",
   "mutate": [{"file": "measured", "set": "scenes", "value": [{"scene": "Assets/Other.unity", "deps": [], "materials": [], "textures": []}]}], "code": "^GAME_SCENE_NOT_IN_BUILD", "expect": "detected"},
  {"id": "S2", "src": "B38", "fault": "설정 art_root가 실제 아트 폴더와 다름(미등록 검사가 꺼짐)", "kind": "judge",
   "mutate": [{"file": "config", "set": "assets.art_root", "value": "Assets/Game/03.Resources/Art"}], "code": "^ART_ROOT_HAS_NO_ASSETS", "expect": "detected"},

  {"id": "K1", "src": "W20", "fault": "채택 에셋의 원본 텍스처가 없음", "kind": "project",
   "mutate": [{"file": "catalog", "set": "assets[id=well].source.texture", "value": "output/none/x.png"}], "code": "MISSING_SOURCE", "expect": "detected"},
  {"id": "K2", "src": "승인 뒤 변경", "fault": "동결 뒤 시드를 바꿈", "kind": "project",
   "mutate": [{"file": "catalog", "add": "assets[id=prop].tripo.seed", "by": 1}], "code": "ARGS_DIFFER", "expect": "detected"},
  {"id": "K3", "src": "승인 뒤 변경", "fault": "동결 뒤 컨셉 그림을 바꿈", "kind": "project",
   "mutate": [{"file": "catalog", "set": "assets[id=prop].tripo.concept", "value": "output/assets/zz/concept/front.png"}], "code": "CONCEPT_DIFFERS", "expect": "detected"},
  {"id": "K4", "src": "핵심 규칙 7", "fault": "지출이 예산 상한을 넘음", "kind": "project",
   "mutate": [{"file": "catalog", "set": "budgets.b.cap", "value": 35}], "code": "OVER_CAP", "expect": "detected",
   "note": "카탈로그에 있는 prop 지출 40만으로 상한 35를 넘는다"},
  {"id": "K5", "src": "B39", "fault": "카탈로그에서 지운 에셋의 지출이 합계에서 빠짐", "kind": "project",
   "mutate": [{"file": "catalog", "set": "budgets.b.cap", "value": 60}], "code": "OVER_CAP", "expect": "detected",
   "note": "prop 40 + 지운 gone 30 = 70 > 60. 지운 에셋을 빼고 세면 40이라 통과한다"},

  {"id": "F1", "src": "핵심 규칙 7", "fault": "승인 원문 없이 유료 생성", "kind": "cli",
   "mutate": [{"file": "docs/art/asset-catalog.json", "set": "budgets.z.approval", "value": ""}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^NO_APPROVAL", "expect": "detected"},
  {"id": "F2", "src": "B42", "fault": "컨셉 그림 없이 생성", "kind": "cli",
   "mutate": [{"rm": "output/assets/zz/concept/front.png"}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^NO_CONCEPT_FILE", "expect": "detected"},
  {"id": "F3", "src": "결정 규칙 5", "fault": "기준서 승인 전 유료 생성", "kind": "cli",
   "mutate": [{"file": "docs/art/spec.md", "replace": "상태: \\*\\*r1 승인\\*\\*", "with": "상태: 초안"}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^SPEC_NOT_APPROVED", "expect": "detected"},
  {"id": "F3b", "src": "B48", "fault": "승인 뒤 기준서 본문을 고치고 유료 생성", "kind": "cli",
   "mutate": [{"file": "docs/art/spec.md", "append_text": "| K2 | 새 값 | 1m |\n"}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^SPEC_CHANGED_AFTER_APPROVAL", "expect": "detected"},
  {"id": "F4", "src": "핵심 규칙 7", "fault": "옛 예산의 승인 원문을 새 에셋이 물려받음", "kind": "cli",
   "mutate": [{"file": "docs/art/asset-catalog.json", "set": "assets[id=zz].tripo.budget", "value": "b"}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^NO_APPROVAL", "expect": "detected",
   "note": "예산 b는 assets 목록에 prop만 있다"},
  {"id": "F5", "src": "W1", "fault": "승인 원문을 에이전트가 직접 씀", "kind": "cli",
   "mutate": [{"file": "docs/art/asset-catalog.json", "set": "budgets.z.approval", "value": "에이전트가 지어낸 문구"}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz"], "code": "^NO_APPROVAL", "expect": "missed",
   "note": "문구가 사용자 말인지는 도구가 알 수 없다. 승인 원문을 받아 적는 절차(핵심 규칙 7)가 막는다"},
  {"id": "F8", "src": "D6", "fault": "같은 에셋을 상한(원본 + 2회) 넘게 재생성", "kind": "cli",
   "mutate": [{"write": "output/assets/zz/tripo/journal.json", "text": "{\"state\": \"DOWNLOADED\", \"credits_task\": 10}"},
              {"write": "output/assets/zz_r2/tripo/journal.json", "text": "{\"state\": \"DOWNLOADED\", \"credits_task\": 10}"},
              {"write": "output/assets/zz_r3/tripo/journal.json", "text": "{\"state\": \"DOWNLOADED\", \"credits_task\": 10}"},
              {"file": "docs/art/asset-catalog.json", "append": "assets", "value": {"id": "zz_r4", "kind": "prop_small", "status": "trial", "method": "build", "folder": "Art/Field/zz_r4",
               "tripo": {"asset": "zz_r4", "budget": "z", "seed": 8, "face_limit": 500, "concept": "output/assets/zz/concept/front.png"}}}],
   "run": ["{py}", "{tools}/assets.py", "gen", "freeze", "zz_r4"], "code": "^REGEN_LIMIT", "expect": "detected"},

  {"id": "H6", "src": "핵심 규칙 1", "fault": "이유 없는 전체 Play(실행기)", "kind": "cli",
   "run": ["{py}", "{tools}/play_check.py", "full"], "code": "FULL_REASON_REQUIRED", "exit": 2, "expect": "detected",
   "covered_by": "play_check selftest: full without reason"},
  {"id": "P2", "src": "W13·B40", "fault": "편집기가 없는데 짧은 Play가 성공으로 끝나고 이전 캡처를 지움", "kind": "cli", "fake_unity": {"dead": 1},
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt"], "code": "EDITOR_NOT_READY", "exit": 4, "keeps": ["pd/probe/old_capture.jpg"], "expect": "detected",
   "covered_by": "play_check selftest: no editor"},
  {"id": "P2b", "src": "W13·B40", "fault": "같은 결함, --keep 옵션", "kind": "cli", "fake_unity": {"dead": 1},
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt", "--keep"], "code": "EDITOR_NOT_READY", "exit": 4, "keeps": ["pd/probe/old_capture.jpg"], "expect": "detected"},
  {"id": "P3", "src": "W21·B40", "fault": "콘솔 오류 3건이 있는 짧은 Play", "kind": "cli", "fake_unity": {"errors": 3},
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt"], "code": "CONSOLE_ERRORS 3", "exit": 1, "expect": "detected",
   "covered_by": "play_check selftest: console errors"},
  {"id": "P4", "src": "W23·W4", "fault": "두 세션이 한 편집기에서 동시에 Play·캡처", "kind": "cli", "hold_editor_lock": true,
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt"], "code": "EDITOR_LOCKED", "exit": 5, "expect": "detected"},
  {"id": "P5", "src": "W6", "fault": "세로 창에서 성능을 재서 낮게 보고", "kind": "cli", "fake_unity": {"size": "776x991"},
   "run": ["{py}", "{tools}/play_check.py", "perf", "{tmp}/perf.json"], "code": "RENDER_SIZE_NOT_1080P", "expect": "detected",
   "covered_by": "play_check selftest: perf tall window refused"},
  {"id": "P7", "src": "B45", "fault": "측정이 빈 결과를 냈는데 짧은 Play 통과", "kind": "cli", "fake_unity": {"result_text": " \n"},
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt"], "code": "RESULT_EMPTY", "exit": 1, "expect": "detected",
   "covered_by": "play_check selftest: empty result"},
  {"id": "P8", "src": "B45", "fault": "이번 실행의 캡처가 없는데 짧은 Play 통과", "kind": "cli", "fake_unity": {"no_capture": 1},
   "run": ["{py}", "{tools}/play_check.py", "short", "P.Run", "r.txt"], "code": "NO_CAPTURE", "exit": 1, "expect": "detected"},

  {"id": "H4", "src": "핵심 규칙 3", "fault": "같은 주제 세 번째 검토", "kind": "hook",
   "mutate": [{"write": "reviews/tp-r001.md", "text": "x"}, {"write": "reviews/tp-r002.md", "text": "x"}],
   "run": ["{py}", "-B", "{tools}/guard.py", "pretool"],
   "payload": {"tool_name": "Bash", "tool_input": {"command": "codex exec \"review\" -o reviews/tp-r003.md"}, "cwd": "{root}"}, "code": "같은 주제 검토", "expect": "detected"},
  {"id": "H5", "src": "핵심 규칙 1", "fault": "이유 없는 전체 Play(훅)", "kind": "hook",
   "run": ["{py}", "-B", "{tools}/guard.py", "pretool"],
   "payload": {"tool_name": "Bash", "tool_input": {"command": "python3 .ai/3d-art/tools/play_check.py full"}, "cwd": "{root}"}, "code": "전체 Play", "expect": "detected"},
  {"id": "H12", "src": "005", "fault": "커밋 전 검사를 --no-verify로 건너뜀", "kind": "hook",
   "run": ["{py}", "-B", "{tools}/guard.py", "pretool"],
   "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit --no-verify -m x"}, "cwd": "{root}"}, "code": "--no-verify", "expect": "detected"},

  {"id": "F6", "src": "T8", "fault": "네트워크 오류 뒤 재전송(중복 과금)", "kind": "selftest",
   "run": ["{py}", "{tools}/selftest_tripo.py"], "code": "^PASS submit fa, network exit 7 -> SUBMISSION_UNKNOWN", "expect": "detected"},
  {"id": "F7", "src": "핵심 규칙 7", "fault": "상한을 넘는 제출", "kind": "selftest",
   "run": ["{py}", "{tools}/selftest_tripo.py"], "code": "^PASS submit fb while fa reserved -> CAP_EXCEEDED", "expect": "detected"},
  {"id": "K6", "src": "B1", "fault": "카탈로그 파일 형식 전체가 바뀜(indent 2)", "kind": "selftest",
   "run": ["{py}", "{tools}/gate.py", "selftest"], "code": "^gate selftest PASS", "expect": "detected",
   "note": "gate 자체 시험은 실패한 사례만 적는다: 'catalog format' 사례가 실패하면 PASS 줄이 없다"},
  {"id": "H11", "src": "W5", "fault": "Play 중단으로 runInBackground 1이 남은 채 커밋", "kind": "selftest",
   "run": ["{py}", "{tools}/gate.py", "selftest"], "code": "^gate selftest PASS", "expect": "detected",
   "note": "gate 자체 시험의 'runInBackground left on' 사례"},
  {"id": "A3", "src": "U7·U2", "fault": "발 미끄러짐·손 침투를 숫자로 못 냄", "kind": "selftest",
   "run": ["{py}", "-c", "import sys; sys.path.insert(0, sys.argv[1]); from kitlib import anim; print(anim.selftest())", "{tools}"], "code": "^anim OK", "expect": "detected"},

  {"id": "A4", "src": "U7", "fault": "걷기 주기·보폭이 기준서 값과 다름(종종걸음)", "kind": "manual", "expect": "not_run",
   "why": "기준서 값과 대조하는 도구가 없다. anim은 숫자만 내고, 사람이 게임 카메라로 본다"},
  {"id": "V1", "src": "U10·U11·U12", "fault": "숫자는 맞는데 걷기가 부자연스러움", "kind": "manual", "expect": "not_run",
   "why": "사람이 본다(핵심 규칙 6). 도구는 그림을 먼저 보게 강제하지 않는다"},
  {"id": "V2", "src": "U13·U6", "fault": "게임 카메라로 안 보고 '잘 나온다'고 보고", "kind": "manual", "expect": "not_run",
   "why": "사람이 본다(핵심 규칙 6)"},
  {"id": "V3", "src": "U16·U17", "fault": "계단·다리가 삐뚤어 보임(수치는 통과)", "kind": "manual", "expect": "not_run",
   "why": "사람이 본다(핵심 규칙 6)"},
  {"id": "V4", "src": "W22", "fault": "보여 줄 그림이 안 열린 채 판정 요청", "kind": "manual", "expect": "not_run",
   "why": "사람이 본다(핵심 규칙 6)"}
 ]
}
