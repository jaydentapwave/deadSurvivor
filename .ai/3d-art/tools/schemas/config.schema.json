    "side_effect_files": {"type": "array", "items": {"type": "string"}},
    "play": {"type": "object", "properties": {"scene": {"type": "string"}, "probe_file": {"type": "string"}, "probe_dir": {"type": "string"}, "short_pass": {"type": "string"}, "require_capture": {"type": "boolean"}, "full_entry": {"type": "string"}, "full_result": {"type": "string"}, "full_pass": {"type": "string"}, "rebuild_call": {"type": "string"}, "perf": {"type": "object"}}},
    "evidence": {"type": "object", "properties": {"runtime": {"type": "array", "items": {"type": "string"}}, "visual": {"type": "array", "items": {"type": "string"}}}},
    "gate": {"type": "object", "properties": {"never_commit": {"type": "array", "items": {"type": "string"}}, "game_paths": {"type": "array", "items": {"type": "string"}}, "art_paths": {"type": "array", "items": {"type": "string"}}, "accepted_check_fails": {"type": "array", "items": {"type": "string"}}, "stage_records": {"type": "array", "items": {"type": "string"}}}},
    "replay_cases": {"type": "string"},
    "metrics": {"type": "string"}
   }
  }
 }
