{
 "schema": "3dkit-config/1",
 "_comment": "Deadsurvivor values for 3dkit (3dkit/workflows/asset-standard.md). assets.profile is the one switch between profiles (3dkit/profiles/). Only keys the 3dkit tools read live here; harness values (tier policy, hooks) stay in Tools/Harness until those tools move to 3dkit.",
 "unity": {
  "version": "6000.4.3f1"
 },
 "assets": {
  "profile": "midpoly",
  "catalog": "docs/art/dq-env-asset-catalog.json",
  "content_root": "Assets/Game",
  "art_root": "Assets/Game/03.Resources/Art/HD2D/RoundDQ3",
  "work_root": "output/3d-art/dq-env",
  "shaders": {
   "palette_lit": "DeadSurvivor/LowPolyPalette"
  },
  "capture": {
   "background": [
    0.31,
    0.61,
    0.2
   ]
  },
  "spec": "docs/art/아트-기준서.md"
 },
 "tripo": {
  "cli": "output/tools/tripo/node_modules/.bin/tripo",
  "home": "output/tripo-state",
  "key_env_file": ".env.local",
  "key_env": "TRIPO_API_KEY",
  "new_work_root": "output/3d-art/dq-env",
  "timezone": "Asia/Seoul",
  "regen_limit": 1
 },
 "blender": "/Applications/Blender.app/Contents/MacOS/Blender",
 "harness": {
  "python": "/usr/bin/python3",
  "metrics": "output/3d-art/dq-env/metrics.jsonl"
 }
}
